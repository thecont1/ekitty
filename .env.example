# Umami Analytics (https://umami.is)
# Copy this file to .env and replace with your actual self-hosted Umami instance values.
VITE_ANALYTICS_ENDPOINT=https://umami.example.com
VITE_ANALYTICS_WEBSITE_ID=00000000-0000-0000-0000-000000000000

# Mr. Bungles provider. LLM_PROVIDER=morph uses Morph (Kimi K3); any other value
# falls back to the generic OpenAI-compatible MR_BUNGLES_* settings below.
LLM_PROVIDER=morph
MORPH_API_KEY=
MORPH_MODEL=morph-kimik3
MORPH_BASE_URL=https://api.morphllm.com/v1

MR_BUNGLES_BASE_URL=https://api.openai.com/v1
MR_BUNGLES_MODEL=
MR_BUNGLES_API_KEY=
